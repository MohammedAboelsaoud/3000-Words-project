{
  "name": "satz",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "predev": "node scripts/tokens-css.mjs",
    "dev": "vite",
    "build": "node scripts/compile-content.mjs && node scripts/tokens-css.mjs && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "node scripts/tokens-css.mjs && tsc --noEmit",
    "content:check": "node scripts/compile-content.mjs && node scripts/check-content.mjs",
    "build:artifact": "node scripts/build-artifact.mjs",
    "content:build": "node scripts/compile-content.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
